{
  "project": {"name":"DGB","version":"3.0.0","model_id":"dgb1","description":"DGB custom LLM framework"},
  "paths": {
    "datasets_dir":"datasets","checkpoints_dir":"checkpoints","logs_dir":"checkpoints/logs",
    "tokenizer_dir":"checkpoints/{model_id}/tokenizer","models_dir":"checkpoints/{model_id}/models",
    "cleaned_dir":"datasets/{model_id}/cleaned","raw_dir":"datasets/{model_id}/wk_raw"
  },
  "dataset": {"raw_glob":"wk_*.txt","cleaned_prefix":"dgb1_cleaned_","chunk_size_chars":500000,
    "min_line_length":20,"max_line_length":2000,"encoding":"utf-8","shuffle":true,"dedup":true,"validation_split":0.1},
  "tokenizer": {"vocab_size":8000,"min_freq":2,"pad_token":"<PAD>","unk_token":"<UNK>",
    "bos_token":"<BOS>","eos_token":"<EOS>","mask_token":"<MASK>","sep_token":"<SEP>",
    "special_tokens_file":"tokenizer/special_tokens/special_tokens.json",
    "stop_words_file":"tokenizer/special_tokens/en_stop_words.json","num_merges":7000,"byte_level":false},
  "transformer": {"vocab_size":8000,"d_model":256,"n_heads":8,"n_encoder_layers":4,
    "n_decoder_layers":4,"d_ff":1024,"dropout":0.1,"max_seq_len":512,"pad_idx":0,
    "tie_embeddings":true,"layer_norm_eps":1e-6,"attention_type":"scaled_dot_product"},
  "training": {"batch_size":32,"epochs":30,"learning_rate":0.0003,"weight_decay":0.01,
    "warmup_steps":1000,"grad_clip":1.0,"save_every_epochs":5,"log_every_steps":1,
    "eval_every_steps":500,"mixed_precision":false,"seed":42,"num_workers":0,"device":"auto"},
  "api": {"host":"0.0.0.0","port":8000,"reload":false,"log_level":"info",
    "cors_origins":["http://localhost:3000","http://localhost:5173"],
    "cors_methods":["GET","POST","PUT","DELETE","OPTIONS"],"cors_headers":["*"],
    "api_prefix":"/api/v1","docs_url":"/docs","redoc_url":"/redoc"},
  "auth": {"algorithm":"HS256","access_token_ttl_min":30,"refresh_token_ttl_days":7,
    "secret_key_env":"DGB_SECRET_KEY","bcrypt_rounds":12},
  "streaming": {"log_server_port":5555,"sse_retry_ms":3000,"ws_ping_interval":20,
    "ws_ping_timeout":10,"queue_maxsize":1000,"flush_interval_sec":0.1},
  "logging": {"level":"INFO","format":"%(asctime)s | %(levelname)-8s | %(name)s | %(message)s",
    "date_format":"%Y-%m-%d %H:%M:%S","file_enabled":true,"file_max_bytes":10485760,
    "file_backup_count":5,"training_log":"checkpoints/logs/{model_id}/training/training.log",
    "progress_log":"checkpoints/logs/{model_id}/training/progress.txt",
    "port_file":"checkpoints/logs/{model_id}/training/training_log_server_port.txt"},
  "memory": {"warn_threshold_gb":1.0,"error_threshold_gb":0.25,"gc_interval_steps":100},
  "search": {"default_provider":"brave","brave_api_key_env":"BRAVE_API_KEY",
    "serpapi_key_env":"SERPAPI_KEY","tavily_key_env":"TAVILY_KEY",
    "num_results":5,"fetch_full_text":true,"rewrite_queries":true},
  "pipeline": {
    "max_concurrent_sources": 2,
    "max_shard_bytes":        536870912,
    "max_shard_records":      1000000,
    "batch_size":             1000,
    "checkpoint_interval":    10,
    "log_every_batches":      10
  },
  "pipeline_stages": {
    "normalize":        true,
    "language_filter":  true,
    "toxicity_filter":  true,
    "quality_scorer":   true,
    "deduplicator":     true
  },
  "normalizer": {
    "min_chars":              50,
    "max_chars":              0,
    "remove_urls":            false,
    "remove_emails":          true,
    "fix_curly_quotes":       true,
    "decode_html_entities":   true,
    "collapse_whitespace":    true
  },
  "language_filter": {
    "target_languages":       ["en"],
    "min_confidence":         0.80,
    "pass_on_uncertainty":    false,
    "fasttext_model_path":    null,
    "source_overrides": {
      "arxiv":     ["en","fr","de","es","zh","ja"],
      "oscar":     ["*"],
      "github":    ["*"]
    }
  },
  "toxicity_filter": {
    "max_toxicity_score":     0.80,
    "max_hate_score":         0.70,
    "max_explicit_score":     0.85,
    "max_spam_density":       3.0,
    "max_injection_density":  1,
    "block_malware":          true,
    "block_pii":              true,
    "block_synthetic":        true,
    "use_model":              false,
    "model_name":             "unbiased"
  },
  "quality_scorer": {
    "min_overall_quality":    0.35,
    "min_alpha_ratio":        0.50,
    "max_digit_ratio":        0.30,
    "max_uppercase_ratio":    0.20,
    "max_repetition_ratio":   0.25,
    "max_boilerplate_ratio":  0.15,
    "max_markup_ratio":       0.05,
    "min_unique_word_ratio":  0.25,
    "min_mean_word_len":      3.0,
    "max_mean_word_len":      15.0,
    "min_words":              20,
    "max_url_density":        5.0
  },
  "deduplicator": {
    "exact_dedup":            true,
    "simhash_dedup":          true,
    "minhash_dedup":          false,
    "simhash_k":              3,
    "minhash_bands":          20,
    "minhash_rows":           5,
    "minhash_threshold":      0.8,
    "save_every":             50000
  },
  "storage_quotas": {
    "global_max_gb":          0,
    "safety_margin_gb":       10,
    "wikipedia_gb":           100,
    "stackexchange_gb":       50,
    "arxiv_gb":               30,
    "gutenberg_gb":           20,
    "commoncrawl_gb":         200,
    "github_gb":              80
  },
  "sources": {
    "wikipedia": {
      "enabled": true,
      "extractor_type": "wikipedia",
      "language": "en",
      "dump_urls": [
        "https://dumps.wikimedia.org/enwiki/20260501/enwiki-20260501-pages-articles-multistream.xml.bz2"
      ],
      "batch_size": 1000,
      "max_docs": 0,
      "download_timeout": 60,
      "max_retries": 5,
      "retry_backoff": 2.0,
      "extra": {
        "wiki_lang": "en",
        "dump_date": "20260501",
        "min_article_chars": 500,
        "max_article_chars": 200000,
        "local_dir": ""
      }
    },
    "stackexchange": {
      "enabled":            false,
      "extractor_type":     "stackexchange",
      "batch_size":         500,
      "max_docs":           0,
      "extra": {
        "min_question_score": 1,
        "min_answer_score":   2,
        "keep_code_blocks":   true,
        "sites": ["stackoverflow","superuser","askubuntu","mathoverflow.net"]
      }
    },
    "arxiv": {
      "enabled":            false,
      "extractor_type":     "arxiv",
      "batch_size":         500,
      "max_docs":           0,
      "dump_urls":          [],
      "extra": {
        "min_abstract_chars": 200,
        "categories":         ["cs","math","physics","stat"],
        "include_title":      true
      }
    },
    "gutenberg": {
      "enabled":            true,
      "extractor_type":     "gutenberg",
      "batch_size":         10,
      "max_docs":           5000,
      "extra": {
        "language_filter":  ["en"],
        "min_chars":        5000,
        "max_books":        5000,
        "source_dir": "datasets/dump/gutenberg"
      }
    },
    "commoncrawl": {
      "enabled":            false,
      "extractor_type":     "commoncrawl",
      "batch_size":         1000,
      "max_docs":           0,
      "extra": {
        "crawl_id":         "CC-MAIN-2024-10",
        "max_warcs":        5,
        "min_chars":        200,
        "domain_blocklist": []
      }
    },
    "github": {
      "enabled":            false,
      "extractor_type":     "github",
      "batch_size":         500,
      "dump_urls":          [],
      "extra": {
        "extensions":       [".py",".js",".ts",".java",".go",".rs",".md"],
        "min_chars":        100,
        "max_chars":        50000
      }
    }
  },
  "finetune": {
    "dataset_path": "datasets/dgb1/finetune/manual/expert.jsonl",
    "epochs": 3,
    "batch_size": 8,
    "checkpoint_dir": "checkpoints/dgb1/finetune",
    "checkpoint_interval_steps": 500,
    "validation_sample_size": 10,
    "lora": {
      "r": 8,
      "alpha": 16,
      "dropout": 0.05
    },
    "freeze_base": true,
    "include_bias_and_norm": false,
    "use_amp": true,
    "max_grad_norm": 1.0,
    "warmup_steps": 100,
    "total_steps": 10000,
    "optimizer": {
      "lr": 1e-4,
      "weight_decay": 0.01,
      "betas": [0.9, 0.95],
      "eps": 1e-8
    }
  }
}
