# JWT signing secret — REQUIRED in production
DGB_SECRET_KEY=change-this-to-a-strong-secret-key

# First admin bootstrap credentials — optional until you create your real admin account
DGB_BOOTSTRAP_ADMIN_USERNAME=admin
DGB_BOOTSTRAP_ADMIN_PASSWORD=change-this-to-a-strong-password

# Web search (optional — enables research mode)
BRAVE_API_KEY=your-brave-search-api-key
SERPAPI_KEY=your-serpapi-key
TAVILY_KEY=your-tavily-key

# Optional: shared rate-limit backend for multi-instance deployments
DGB_REDIS_URL=redis://localhost:6379/0

# External storage (optional — override data/model paths)
DGB_RAW_DIR=C:\Users\Cosmas\Documents\Backup\dgb_version\datasets\dump\gutenberg\raw\all_books
